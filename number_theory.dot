digraph G {
    layout=neato;
    overlap="false";
    sep="+15";
    node [shape=box, fontsize=20, margin="0.15,0.1"];

    labelloc=t
    fontsize=28
    label="3.3 prime residue classes and Fermat-Euler theorem (Def 3.13 — Cor 3.32)
3.4 cyclic groups (Def 3.33 — Thm 3.49)
from: script of Heidelberg University fall 2024 \"Elementary Number Theory\" lecture
[https://github.com/Hermann-SW/graphviz\_latex\_pipeline]

"
    URL="https://github.com/Hermann-SW/graphviz_latex_pipeline"
    comment="
\documentclass[varwidth=30cm, fontsize=12, border=5pt]{standalone}
\usepackage{amsmath, amsfonts, amsthm, amssymb, lmodern}

\newcommand\Z{\ensuremath{\mathbb{Z}}}
\newcommand\N{\ensuremath{\mathbb{N}}}

% Define a custom overline with extra vertical clearance
\newcommand{\rclass}[1]{\overline{\rule{0pt}{1.7ex}#1}}

\begin{document}
\raggedright
% Remove automatic math spacing
%\thinmuskip=0mu
%\medmuskip=0mu
%\thickmuskip=0mu
\fontsize{24}{28}\selectfont

\end{document}
"
    def_3_13 [comment="
\textbf{Def 3.13 } Ring $R, x\in R: \exists y\in R\setminus \{0\}: xy=0$,\\
    then x is called zero divisor
"];
    ex_3_14 [comment="
\textbf{Ex 3.14 } zero divisors in $\Z/3\Z: \bar{0}$, so has no zero divisors\\
zero divisors in $\Z/4\Z: \bar{0},\bar{2}$, so has zero divisor
"];
    def_3_15 [comment="
\textbf{Def 3.15 } Ring $R, x\in R:\textrm{ if }\exists y\in R: xy=1$,\\
then $x$ is called a unit
"];
    ex_3_16 [comment="
\textbf{Ex 3.16 } units in $\Z/3\Z: \bar{1},\bar{2}$\\
units in $\Z/4\Z: \bar{1},\bar{3}$
"];
    prop_3_17 [comment="
\textbf{Prop 3.17 } $R$ ring\\
(a) $R^{\times}:=\{x\in R: x$ is unit\} with $\cdot$\ is (abelian) group of units\\
(b) $x\in R^{\times} \implies\ x$ no zero divisor\\
(c) $R$ finite, then also: $x\in R$ no zero divisor $\implies\ x$ is unit
"];
    ex_3_18 [comment="
\textbf{Ex 3.18 } Finite ring $R=\Z/n\Z,\ n\in \N,\ x\in R$:\\
$\bar{x}\textrm{ unit }\iff \bar{x}$ no zero divisor\\
Units in $R$ are called coprime residue classes modulo $n$\\
$(\Z/n\Z)^{\times}$ is called multiplicative group of integers modulo n
"];
    def_3_19 [comment="
\textbf{Def 3.19 } (Commutative) ring $R$\\
with $R^{\times} = R \setminus \{0\}$ is called field
"];
    ex_3_20 [comment="
\textbf{Ex 3.20 } $\Z/3\Z$\ is field, $\Z/4\Z$\ and zero ring are no fields.
"];
    thm_3_21 [comment="
\textbf{Thm 3.21 } $n\in \N$, these are equivalent\\
(i) $n$ is prime\\
(ii) $\Z/n\Z$\ is field\\
(iii) $\Z/n\Z$\ has no zero divisors
"];
    prop_3_22 [comment="
\textbf{Prop 3.22 } $a\in \mathbb{N},\ \bar{a}\in \Z/n\Z:$\\
$\bar{a}\in (\Z/n\Z)^{\times} \iff \gcd(a,n)=1$
"];
    cor_3_23 [comment="
\textbf{Cor 3.23 } $n\in \mathbb{N},\ a\in \Z$:\\
$(\exists x\in \Z: ax\equiv 1 (\mod\ n)) \iff \gcd(a,n)=1$
"];
    ex_3_24 [comment="
\textbf{Ex 3.24 } Solutions for\\
$3x\equiv 1 (mod\ 37): L=25+37\Z$
"];
    prop_3_25 [comment="
\textbf{Prop 3.25 } $a,b\in \Z, n\in\N$\\
$(\exists x\in\Z: ax\equiv b\ (mod\ n)) \iff \gcd(a,n)\mid b$
"];
    ex_3_26 [comment="
\textbf{Ex 3.26 } (a) $\nexists x\in \Z: 15x\equiv 7 (\mod\ 21)$\\
(b) $\exists x\in\Z: 15x\equiv 6 (\mod\ 21)$
"];
    def_3_27 [comment="
\textbf{Def 3.27 } Order $\vert G\vert$\ of group\\
is number of its elements
"];
    ex_3_28 [comment="
\textbf{Ex 3.28 }$\vert(\Z/n\Z)^{\times}\vert=\phi(n)$
"];
    prop_3_29 [comment="
\textbf{Prop 3.29 } $G$ finite abelian group.\\
$\forall g\in G: g^{\vert G\vert} =1$
"];
    thm_3_30 [comment="
\textbf{Thm 3.30 } (Fermat-Euler theorem)\\
$n\in \mathbb{N}.\ \forall \bar{a}\in (\Z/n\Z)^{\times}:\ \bar{a}^{\phi(n)} =\bar{1}$
"];
    ex_3_31 [comment="
\textbf{Ex 3.31 } $3^{19}\equiv 10\ (mod\ 17)$
"];
    cor_3_32 [comment="
\textbf{Cor 3.32 } (Fermat's little theorem) $p$ prime:\\
(a) $\forall \bar{a}\in \mathbb{F}_p^{\times}: \bar{a}^{p-1}=\bar{1}$\\
(b) $\forall \bar{a}\in \mathbb{F}_p: \bar{a}^p=\bar{a}$
"];
    def_3_33 [comment="
\textbf{Def 3.33 } Group G is cyclic:\\
$\exists g\in G$ generator with\\
$G = \{g^n: n\in \Z\}=:<g>$
"];
    rem_3_34 [comment="
\textbf{Rem 3.34 } Every cyclic group is abelian.
"];
    ex_3_35 [comment="
\textbf{Ex 3.35 }(a) group $(\Z/5\Z)^{\times} = \{\rclass{1},\rclass{2},\rclass{3},\rclass{4}\}$ is cyclic\\
(b) group $(\Z/8\Z)^{\times} = \{\rclass{1},\rclass{3},\rclass{5},\rclass{7}\}$ is not cyclic\\
(c) additive group $\Z$\ is cyclic\\
(d) additive group $\Z/m\Z =\{\rclass{0},\rclass{1},\dots,\rclass{m-1}\}$\ is cyclic
"];
    def_3_36 [comment="
\textbf{Def 3.36 } $G$ finite abelian group.\\
Order $ord(G):=\min\{n\in \mathbb{N}: g^n=1\}$
"];
    ex_3_37 [comment="
\textbf{Ex 3.37 }For $G=(\Z/5\Z)^{\times}:$\\
(a) $ord(\bar{2})=4$\\
(b) $ord(\bar{4})=2$
"];
    prop_3_38 [comment="
\textbf{Prop 3.38 }$G$ finite abelian group:\\
$G$ is cyclic $\iff \exists g\in G\textrm{ with }ord(g)=\vert G\vert$
"];
    prop_3_39 [comment="
\textbf{Prop 3.39 }$G$ finite abelian group,\\
$g\in G, m\in \Z: ord(g)\mid m \iff g^m=1$
"];
    cor_3_40 [comment="
\textbf{Cor 3.40 } $G$ finite abelian group.\\
$\forall g\in G: ord(g) \mid\ \vert G\vert$
"];
    def_3_41 [comment="
\textbf{Def 3.41 } $G$ finite abelian group.\\
Exponent $\exp(G):=\min\{n\in \mathbb{N}: g^n=1\ \forall g\in G\}$
"];
    ex_3_42 [comment="
\textbf{Ex 3.42 }(a) $exp((\Z/5\Z)^{\times})=4$\\
(b) $exp((\Z/8\Z)^{\times})=2$
"];
    prop_3_43 [comment="
\textbf{Prop 3.43 }$G$ finite abelian group:\\
(a) $\exp(G) \mid\ \vert G\vert$\\
(b) $\exp(G)= lcm(\{ord(g): g\in G\})$
"];
    def_3_44 [comment="
\textbf{Def 3.44 } homomorphism\\ isomorphism, $\cong$
"];
    ex_3_45 [comment="
\textbf{Ex 3.45 }$K$ field implies\\
$det:GL_n(K)\to  K^{\times}$ homomorphism
"];
    prop_3_46 [comment="
\textbf{Prop 3.46 }$G, H$ groups, $\psi: G\to\ H$ homomorphism:\\
(a) $\psi \text{ injective} \iff \text{ker}(\psi):=\{g\in G: \psi(g)=1\}=\{1\}$\\
(b) $\psi \text{ isomorphism} \iff \psi^{-1}: H\to G$ isomorphism
"];
    thm_3_47 [comment="
\textbf{Thm 3.47 }For cyclic group $G$:\\
$G \cong \begin{cases}
\ \mathbb{Z} & \text{for }G\text{ infinite,}\\
\ \Z /|G|\mathbb{Z} & \text{for }G\text{ finite.} \end{cases}$
"];
    ex_3_48 [comment="
\textbf{Ex 3.48 } $(\Z/5\Z)^{\times} \cong \Z/4\Z$\\
$\psi: \begin{cases}\ \Z/4\Z &\to\ (\Z/5\Z)^{\times}\\
\ a & \mapsto\ \rclass{2}^a \end{cases}$
"];
    thm_3_49 [comment="
\textbf{Thm 3.49 }$G$ finite abelian group:\\
$G$ is cyclic $\iff \exp(G) = \vert G\vert$
"];

    def_3_13 -> ex_3_14 [style=dotted];
    def_3_15 -> ex_3_16 [style=dotted];
    { def_3_13 def_3_15 } -> prop_3_17 [style=dotted];
    ex_3_14 -> ex_3_16 [style=invis,arrowhead=none];
    prop_3_17 -> ex_3_18 [style=dotted];
    prop_3_17 -> thm_3_21;
    { ex_3_16 def_3_19 } -> ex_3_20 [style=dotted];
    ex_3_20 -> thm_3_21;
    prop_3_29 -> def_3_36;
    thm_3_21 -> prop_3_22 [style=dotted];
    prop_3_22 -> cor_3_23 [style=dotted];
    def_3_19 -> thm_3_21;
    cor_3_23 -> ex_3_24 [style=dotted];
    cor_3_23 -> prop_3_25 [style=dotted];
    prop_3_25 -> ex_3_26 [style=dotted];
    ex_3_24 -> def_3_27 [style=invis,arrowhead=none];
    prop_3_22 -> ex_3_28;
    def_3_27 -> ex_3_28 [style=dotted];
    def_3_33 -> ex_3_35 [style=dotted];
    def_3_36 -> ex_3_37 [style=dotted];
    thm_3_30 -> { ex_3_31 cor_3_32 };
    { ex_3_28 prop_3_29 } -> thm_3_30;
    ex_3_31 -> cor_3_32 [style=invis,arrowhead=none];
    def_3_33 -> rem_3_34 [style=dotted];
    def_3_41 -> prop_3_43 [style=dotted];
    prop_3_39 -> cor_3_40;
    prop_3_39 -> prop_3_43;
    def_3_44 -> { ex_3_45 prop_3_46 } [style=dotted];
    prop_3_38 -> thm_3_47;
    prop_3_39 -> thm_3_47;
    def_3_36 -> prop_3_38 [style=dotted];
    prop_3_46 -> thm_3_47 [style=dotted];
    prop_3_29 -> cor_3_40;
    def_3_41 -> ex_3_42 [style=dotted];
    { ex_3_35 thm_3_47 } -> ex_3_48;
    { prop_3_39 prop_3_43 } -> thm_3_49;
    prop_3_38 -> thm_3_49;
}
