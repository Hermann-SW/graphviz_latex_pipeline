digraph G {
    layout=dot;
    overlap="false";
    sep="+15";
    node [shape=box, fontsize=12, margin="0.15,0.1", height=0];

    labelloc=t
    label="Fermat's last theorem for n=4
(any field K has been replaced with ℚ)
from: Kato, Kazuya, Nobushige Kurokawa, and Takeshi Saitō.
Number Theory: Fermat’s dream. AMS Bookstore, 2000.

"
    comment="
\documentclass[varwidth=true, border=5pt]{standalone}
\usepackage{amsmath, amsfonts, amsthm, amssymb, wasysym}

\newcommand\Z{\ensuremath{\mathbb{Z}}}
\newcommand\N{\ensuremath{\mathbb{N}}}
\newcommand\Q{\ensuremath{\mathbb{Q}}}

\begin{document}
% Remove automatic math spacing
%\thinmuskip=0mu
%\medmuskip=0mu
%\thickmuskip=0mu

\end{document}
"

    prop_0_13 [comment="
\textbf{Prop 0.13 } The area of a right $\triangle$\\
whose sides are integers is not a $\square$
"];

    prop_1_1 [comment="
\textbf{Prop 1.1 } $\nexists$\ solution $(x,y,z)$ to\\
$x^4+y^4=z^4$ satisfying $xyz\neq 0$
"];
    prop_1_2 [comment="
\textbf{Prop 1.2 } The only rational solutions to\\
$y^2=x^3-x$ are $(x,y)=(0,0)$ and $(\pm 1,0)$
"];
    def_mul [comment="
\textbf{Def *} Elliptic curve over $\Q$ is equation of form:\\
$y^2=ax^3+bx^2+cx+d\ (a,b,c,d\in Q, a\neq 0)$\\
where RHS polynomial has no multiple root
"];
    lem_1_3 [comment="
\textbf{Lem 1.3 } $d\in\mathbb{Q}$, these are equivalent:\\
(i) $\exists$\ rational number sides \textbf{right }\triangle\ of area d\\
(ii) $\exists$\ 3 \square{{}}s of rational numbers that form\\
 arithmetic progression of difference $d$\\
(iii) $\exists$\ rational solution to $y^2=x^3-d^2x$\\
 other than $(x,y)=(0,0)\textrm{ and }(\pm d,0)$
"];
    lem_1_4 [comment="
\textbf{Lem 1.4} For $d\in \Q$ define:\\
$A_d=\{(x,y,z)\in \Q\times\Q\times\Q\ \vert\ x^2+y^2=z^2,½xy=d\}$\\
$B_d=\{(u,v,w)\in \Q\times\Q\times\Q\ \vert\ u^2+d=v^2,\ v^2+d=w^2\}$\\
$C_d=\{(x,y)\in \Q\times\Q\ \vert\ y^2=x^3-d^2x,\ y\neq 0\}$.\\
$\exists\textrm{ bijections between any 2 of }A_d, B_d, C_d$
"];
    _lem_1_4 [comment="
$i:(x,y,z)\mapsto \left(\frac{y-x}{2},\frac{z}{2},\frac{x+y}{2}\right)$\\
$j:(u,v,w)\mapsto (w-u,w+u,2v)$
"];
    lem_1_5 [comment="
\textbf{Lem 1.5} For distinct $a,b,c\in \mathbb{Q}$ define $B, \tilde{C}\textrm{ and }C$\\
$B=\{(u,v,w)\in \mathbb{Q}\times\mathbb{Q}\times\mathbb{Q}\ \vert\ u^2+a=v^2+b=w^2+c\}$\\
$\tilde{C}=\{(x,y)\in \mathbb{Q}\times\mathbb{Q}\ \vert\ y^2=(x-a)(x-b)(x-c)\}$.\\
$C=\{(x,y)\in \mathbb{Q}\times\mathbb{Q}\ \vert\ y^2=(x-a)(x-b)(x-c),\ y\neq 0\}$.\\
(1) $\exists$\ mutually inverse maps $f:B\to C,\ g:C\to B$\\
$f(u,v,w)=(u^2+a+uv+vw+wu,\ (u+v)(v+w)(w+u))$,\\
$g(x,y)=\left(\frac{1}{2y}((x-a)^2-(b-a)(c-a)),\right.$\\
$\left.\frac{1}{2y}((x-b)^2-(a-b)(c-b)),\ \frac{1}{2y}((x-c)^2-(a-c)(b-c))\right)$\\ 
(2) $\exists$\ map $h:B\to \tilde{C},\ h(u,v,w)=(u^2+a,uvw)$
"];
    rem_1_6 [comment="
\textbf{Rem 1.6 } $h\circ g:C\to \tilde{C}$ is called multiplication-by-2 map\\
 for elliptic curve $y^2=(x-a)(x-b)(x-c)$; image of $h\circ g$ is\\
 $\{(x,y)\in \mathbb{Q}\times\mathbb{Q}\ \vert\ y^2=(x-a)(x-b)(x-c),\ x-a,\ x-b,\ x-c\textrm{ are {\square}s in }\mathbb{Q}\}$\\
because:\\
$(x',y')=h(u,v,w) \implies\ x'=u^2+a \implies\ x'-a\textrm{ is \square\ in }\mathbb{Q}$\\
from definition of $B$ (image of $g$): $u^2+a=v^2+b=w^2+c$\\
 $x'-b =(v^2+b)-b=v^2\textrm{ is {\square}\ in }\mathbb{Q}$\\
 $x'-c =(w^2+c)-c=w^2\textrm{ is {\square}\ in }\mathbb{Q}$
"];
    def_height [comment="
\textbf{Def } For $a=\frac{m}{n}$ with $m,n\in \N,\ (m,n)=1$\\
define height $H(a):=max(\vert m\vert, \vert n\vert)$
"];
    i [comment="
\textbf{(i) } Let $(x_0,y_0)$ on $y^2=x^3-x$ with $y_0\neq 0$\\
and minimal $H(x_0)$; by above we can assume $1<x_0$
"];
    ii [comment="
\textbf{(ii) } $x_0-1$, $x_0$ and $x_0+1$ are all {\square}s\\
$\implies\ \exists (x_1,y_1)\in C: h\circ g(x_1,y_1)=(x_0,y_0)$
"];
    iii [comment="
\textbf{(iii) } $H(x_1)<H(x_0)$, \lightning 
"];
    join1 [shape=point]
    img [label="" shape=plaintext image="res/ec.png"]

    { rank=same prop_0_13 lem_1_3 prop_1_2 }
    { rank=same lem_1_5 _lem_1_4 }
    { rank=same rem_1_6 join1 }
    { rank=same i img }

    lem_1_3 -> prop_0_13 [comment="
$\neg(i)\\d=1$
"]
    prop_0_13 -> lem_1_3 
    def_mul -> lem_1_5 [style=dotted]
    lem_1_3 -> prop_1_2 [comment="
$\neg(iii)\\d=1$
"]
    prop_1_2 -> lem_1_3 
    lem_1_5 -> lem_1_4 [comment="
 $a=d,\ b=0,\ c=-d,\ \begin{cases}
 f:B_d\to C_d\\g:C_d\to B_d\end{cases}$
"]
    lem_1_4 -> lem_1_3 [comment="
$ \begin{cases}(i)&\implies A_d \neq \emptyset\\
 (ii)&\implies B_d \neq \emptyset\\
 (iii)&\implies C_d \neq \emptyset\end{cases}$
"]
    lem_1_5 -> rem_1_6 

    _lem_1_4 -> lem_1_4 [comment="
$\begin{cases}i:A_d\to B_d\\j:B_d\to A_d\end{cases}$
"];
    _lem_1_4 -> lem_1_5 [style=invis];
    prop_1_2 -> prop_1_1 [comment="
 multiply a 1.1 solution by $\dfrac{z^2}{y^6}$, \lightning:\\
$0\neq\left(\dfrac{x^2z}{y^3}\right)^2$
$=\left(\dfrac{z^2}{y^2}\right)^3-\dfrac{z^2}{y^2}$
"]

    def_height -> i [comment="
$(x,y)$ on elliptic curve\\
$\implies\ (\frac{-1}{x},\frac{y}{x^2})$ on curve as well,\\
$H(x)=H(-1/x)$
" style=dotted]
    rem_1_6 -> join1 [comment="a=1,\ b=0,\ c=-1"]
    i -> join1 -> ii -> iii
    img -> i [style=invis]
}
